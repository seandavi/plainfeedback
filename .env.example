# Copy to .env. No real secrets here; production secrets come from GCP Secret Manager.
# Used by `docker compose` (the default below is a local-dev-only password; override it).
# POSTGRES_PASSWORD=plainfeedback-dev-only
# APP_PORT=3000
# DB_PORT=5432

# Used by `just dev` (server on the host, db from `just up`).
DATABASE_URL=postgresql://plainfeedback:plainfeedback-dev-only@localhost:5432/plainfeedback

# Staff auth (see docs/deploy-auth.md). Locally use a dev OAuth client; never commit real values.
# OIDC_PROVIDER=Google
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
# ALLOWED_EMAIL_DOMAINS=example.org
# ADMIN_EMAILS=you@example.org
# COOKIE_SECURE=false only for plain-http localhost
# COOKIE_SECURE=false
# SESSION_TTL_HOURS=12
# SESSION_IDLE_HOURS=2

# Participant submissions (docs/deploy.md#client-address-and-rate-limits).
# TRUST_PROXY=x-forwarded-for
# RATE_LIMIT_SURVEY_BURST=1000
# RATE_LIMIT_SURVEY_PER_SECOND=10
# RATE_LIMIT_CLIENT_MAX=30
# RATE_LIMIT_CLIENT_WINDOW_MINUTES=10

# Public origin of the app, used for survey links and QR codes (required; no path).
PUBLIC_BASE_URL=http://localhost:3000
