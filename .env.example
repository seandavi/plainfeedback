# Copy to .env. No real secrets here; production secrets come from GCP Secret Manager.
# Used by `docker compose` (the default below is a local-dev-only password; override it).
# POSTGRES_PASSWORD=plainfeedback-dev-only
# APP_PORT=3000
# DB_PORT=5432

# Used by `just dev` (server on the host, db from `just up`).
DATABASE_URL=postgresql://plainfeedback:plainfeedback-dev-only@localhost:5432/plainfeedback
